# xstockstrat — Environment Variables Example
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# Three-file convention:
#   .env.local    — committed; structural overrides for all services (APPLICATION_ENV,
#                   NODE_ENV). No secrets. Loaded by docker-compose (env_file) and Next.js.
#   .env.fe.local — committed; frontend-only overrides (APP_URL). Loaded by docker-compose
#                   only on the 3 Next.js services (trader, insights, config-ui).
#   .env          — not committed; secrets and credential-linked vars (POSTGRES_PASSWORD,
#                   ALPACA_*, JWT_SECRET, OTEL_EXPORTER_OTLP_ENDPOINT,
#                   OTEL_EXPORTER_OTLP_HEADERS, etc.). Copy .env.example → .env to get started.
#
# DigitalOcean App Platform: secrets are set once via `doctl apps update --set-env`
# or the DO dashboard (App → Settings → Environment Variables → Encrypt). They are
# NEVER stored in committed files. See docs/setup/digitalocean.md Step 7.

# ── Database ───────────────────────────────────────────────────────────────
# Local dev only. In production, DATABASE_URL is injected by DigitalOcean App Platform
# from the managed database component — never stored here or in git.
#
# docker-compose constructs DATABASE_URL automatically from POSTGRES_PASSWORD using the
# bridged-network hostname (timescaledb). You only need to set POSTGRES_PASSWORD here.
POSTGRES_PASSWORD=devpassword

# Feature 133: seed owner assigned to any pre-existing strategies by analysis migration 013.
# Only consulted when the local DB already has strategies; safe as-is for a fresh local DB.
SEED_USER_ID=80880990-2b79-4d85-8761-d8d9102c2efb

# ── Vendor Credentials (Alpaca / FMP / Finnhub) — now in encrypted config ─
# Feature 147: ALPACA_API_KEY, ALPACA_API_SECRET, FMP_API_KEY and FINNHUB_API_KEY are no longer
# env vars. They are stored ENCRYPTED in xstockstrat-config and resolved by xstockstrat-marketdata
# at startup via the GetSecret RPC. Set them once per environment after deploy through the
# config write path (an operator action) — never in this file.

# ── JWT (xstockstrat-identity, xstockstrat-ui, xstockstrat-agent) ─────────
# Verified by identity (issuer), the UI (edge auth), and — feature 147 — the agent, where it also
# HMAC-signs the stateless OAuth 2.1 txn blob (app/oauth_server.py), replacing MCP_AGENT_SECRET.
JWT_SECRET=change-me-in-production-use-32-char-minimum

# ── Config Secrets Encryption Key (xstockstrat-config) ───────────────────
# Feature 147: AES-256 master key for encrypting config secrets at rest. Hex-encoded 32 bytes
# (64 hex chars). Generate: openssl rand -hex 32. Use different keys for dev and prod. The config
# service refuses to start without it.
CONFIG_SECRETS_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Broker Accounts Encryption Key (xstockstrat-trading) ─────────────────
# AES-256 key for encrypting broker credentials stored in the broker_accounts
# table. Must be a hex-encoded 32-byte (64 hex character) value.
# Generate: openssl rand -hex 32
# Use different keys for dev and prod. Required when broker_accounts are in use.
BROKER_ACCOUNTS_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Web Push / VAPID (xstockstrat-notify + xstockstrat-ui) ────────────────
# Feature 163: Web Push notifications for the installable PWA. Generate a keypair with
# `npx web-push generate-vapid-keys`. VAPID_PRIVATE_KEY is a secret (notify only); VAPID_PUBLIC_KEY
# is consumed by BOTH notify and the UI; VAPID_SUBJECT is a mailto:/https: contact URL (notify only).
# All three EMPTY ⇒ push is disabled (the enable control reports "not configured"). Set the same
# public key in both services.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# ── GitHub Container Registry (GHCR) ──────────────────────────────────────
# Images are pushed by CI to ghcr.io/davcs86/xstockstrat/<service>:latest-dev.
# docker compose build  → builds from Dockerfile, tags as ghcr.io/davcs86/xstockstrat/<service>:latest-dev
# docker compose pull   → pulls the CI-built image from GHCR (packages must be public, or authenticate:
#                         echo $GITHUB_TOKEN | docker login ghcr.io -u davcs86 --password-stdin)
# No env var needed — the image path is hardcoded in docker-compose.yml.

# ── OpenTelemetry (Observability) ──────────────────────────────────────────
# OTEL_ENABLED defaults to false in docker-compose and DO. Set to true in .env
# (Docker) or via the DO dashboard to activate OTLP export.
# See docs/setup/grafana-cloud.md for full setup instructions.
#
# OTEL_EXPORTER_OTLP_ENDPOINT — Grafana Cloud OTLP gateway URL.
# Docker: used by the otel-collector to forward to Grafana Cloud.
# DO App Platform: used by each service's OTel SDK to push directly (no collector).
#   https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp

# OTEL_EXPORTER_OTLP_HEADERS — Authorization header value for Grafana Cloud.
# Docker (.env): value is the header VALUE only: Basic <base64(instanceId:apiKey)>
#   The otel-collector config injects it as: Authorization: "${OTEL_EXPORTER_OTLP_HEADERS}"
# DO App Platform: set as a single global secret via DO dashboard — value is
#   the standard OTel SDK key=value format: Authorization=Basic <base64(instanceId:apiKey)>
# Generated at: Grafana Cloud → Connections → Add new connection → OpenTelemetry
OTEL_EXPORTER_OTLP_HEADERS=Basic <base64-encoded-instance-id-and-api-key>

# ═══════════════════════════════════════════════════════════════════════════
# GitHub Repository Secrets (NOT local .env — set in GitHub only)
# ═══════════════════════════════════════════════════════════════════════════
# The variables below are NOT used locally. They must be added as repository
# secrets in GitHub → Settings → Secrets and variables → Actions.
# See docs/setup/digitalocean.md Step 9 for setup instructions.
#
# Secret Name               Used by workflow            How to obtain
# ─────────────────────────────────────────────────────────────────────────
# DIGITALOCEAN_ACCESS_TOKEN deploy-dev / deploy-prod    DigitalOcean API PAT
# DO_DEV_APP_ID             deploy-dev                  doctl apps list (dev app)
# DO_PROD_APP_ID            deploy-prod                 doctl apps list (prod app)
# BUF_TOKEN                 deploy-dev / deploy-prod    buf.build → Settings → Tokens
# GH_PAT_SCAN               ci (secret-scan job)        GitHub PAT with repo read scope
# DEV/PROD_VAPID_PRIVATE_KEY  deploy-dev / deploy-prod  npx web-push generate-vapid-keys (feature 163)
# DEV/PROD_VAPID_PUBLIC_KEY   deploy-dev / deploy-prod  the paired public key (non-secret)
# DEV/PROD_VAPID_SUBJECT      deploy-dev / deploy-prod  a mailto: or https: contact URL
#
# GITHUB_TOKEN is automatically provided by GitHub Actions — no setup needed.
