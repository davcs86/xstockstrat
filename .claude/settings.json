{
  "enabledMcpjsonServers": ["digitalocean-apps", "digitalocean-databases", "digitalocean-droplets", "digitalocean-volumes", "digitalocean-spaces", "digitalocean-accounts", "digitalocean-insights"],
  "extraKnownMarketplaces": {
    "davcs86-agent-plugins": {
      "source": {
        "source": "github",
        "repo": "davcs86/agent-plugins"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "context-forge@davcs86-agent-plugins": true,
    "design-buddy@davcs86-agent-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [[ \"$f\" == *.sh ]] && chmod +x \"$f\"; } 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [[ \"$f\" == *feature.md ]] && \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/on-feature-md-edit.sh \"$f\" || true; } 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [[ \"$f\" == *CLAUDE.md ]] && echo \"[hook] $f modified — run /proofread-claude-md $f to check for stale references or contradictions\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
