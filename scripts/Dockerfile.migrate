FROM postgres:16-alpine

RUN apk add --no-cache bash curl gettext

# Pin version for reproducibility — bump here when upgrading golang-migrate
ARG MIGRATE_VERSION=4.17.1
RUN curl -fsSL --retry 8 --retry-all-errors --retry-max-time 300 -o /tmp/migrate.tgz \
    "https://github.com/golang-migrate/migrate/releases/download/v${MIGRATE_VERSION}/migrate.linux-amd64.tar.gz" \
    && tar xzf /tmp/migrate.tgz -C /usr/local/bin migrate \
    && rm /tmp/migrate.tgz

COPY scripts/db-migrate.sh /repo/scripts/db-migrate.sh
COPY scripts/render-migrations.sh /repo/scripts/render-migrations.sh
COPY scripts/migration-dirty-guard.sh /repo/scripts/migration-dirty-guard.sh
COPY scripts/migration-ahead-check.sh /repo/scripts/migration-ahead-check.sh
COPY services /repo/services
WORKDIR /repo

ENTRYPOINT ["/repo/scripts/db-migrate.sh"]
