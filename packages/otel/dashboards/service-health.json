{
  "__inputs": [
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Grafana Cloud Tempo (traces) datasource",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["xstockstrat", "service-health", "tempo"],
  "templating": {
    "list": [
      {
        "name": "DS_TEMPO",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "label": "Tempo"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "xstockstrat — Service Health",
  "uid": "xstk-service-health",
  "panels": [
    {
      "title": "Server error spans",
      "type": "table",
      "description": "Server-side gRPC spans that ended with an error status, newest first.",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ kind = server && status = error }",
          "limit": 50,
          "tableType": "spans"
        }
      ]
    },
    {
      "title": "slow server spans (>2s)",
      "type": "table",
      "description": "Server-side spans longer than 2s. Server-streaming RPCs (Watch/Stream/Export) are excluded because they are long-lived by design. Long-lived non-gRPC spans such as the agent's subscriptions/listen also match.",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ kind = server && duration > 2s && name !~ \".*/(Watch|Stream|Export)[A-Za-z]*\" }",
          "limit": 50,
          "tableType": "spans"
        }
      ]
    },
    {
      "title": "analysis scoring RPC activity",
      "type": "table",
      "description": "Analysis RunBacktest and ScoreStrategy server spans. Not a stall signal: both RPCs are client-invoked, so an empty panel can mean nobody called them.",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"analysis\" && kind = server && name =~ \".*/(RunBacktest|ScoreStrategy)\" }",
          "limit": 50,
          "tableType": "spans"
        }
      ]
    }
  ]
}
