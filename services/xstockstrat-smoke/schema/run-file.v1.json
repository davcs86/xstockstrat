{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xstockstrat.local/smoke/run-file.v1.json",
  "title": "xstockstrat-smoke run file v1 (one file per run)",
  "type": "object",
  "required": [
    "schema_version", "run_id", "env", "deployed_sha", "started_at", "trigger",
    "triggered_by", "records"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "env": { "enum": ["homelab-staging", "do-dev"] },
    "deployed_sha": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "trigger": { "type": "string", "minLength": 1 },
    "triggered_by": { "type": "string", "minLength": 1 },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "additionalProperties": true,
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "check_id", "check_hash", "feature", "part", "outcome", "started_at", "duration_ms",
        "rpcs_invoked", "evidence"
      ],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "check_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "feature": { "type": "string", "minLength": 1 },
        "part": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["PASS", "FAIL", "ERROR", "TIMEOUT"] },
        "started_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "rpcs_invoked": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      },
      "additionalProperties": true
    }
  }
}
