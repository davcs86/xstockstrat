        "DB_POOL_MAX": "2",
        "GRPC_PORT": "50060",
        "MTLS_CA_CERT": "${MTLS_CA_CERT:?MTLS_CA_CERT is required}",
        "MTLS_CERT": "${CONFIG_MTLS_CERT:?CONFIG_MTLS_CERT is required}",
        "MTLS_KEY": "${CONFIG_MTLS_KEY:?CONFIG_MTLS_KEY is required}",
        "OTEL_ENABLED": "false",
        "SERVICE_NAME": "config",
        "TRADING_MODE": "${TRADING_MODE:?TRADING_MODE is required}"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 6,
        "start_period": "120s",
        "test": [
          "CMD",
          "nc",
          "-z",
          "127.0.0.1",
          "50060"
        ],
        "timeout": "5s"
      },
      "image": "${IMAGE_CONFIG:?IMAGE_CONFIG is required}",
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
