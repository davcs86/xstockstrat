{
  "services": {
    "db-migrator": {
      "environment": {
        "DATABASE_URL": "postgresql://${DB_USER:?DB_USER is required}:${DB_PASSWORD:?DB_PASSWORD is required}@${DB_HOST:?DB_HOST is required}:5432/${DB_NAME:?DB_NAME is required}?sslmode=require",
        "SEED_USER_ID": "${SEED_USER_ID:?SEED_USER_ID is required}"
      },
      "image": "${IMAGE_DB_MIGRATOR:?IMAGE_DB_MIGRATOR is required}",
      "networks": {
        "default": null
      },
      "restart": "no"
    },
    "xstockstrat-agent": {
      "depends_on": {
        "xstockstrat-analysis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": [
        "AGENT_PUBLIC_URL=${APP_URL}/agent",
        "ANALYSIS_ENDPOINT=xstockstrat-analysis:50056",
        "APPLICATION_ENV=${APPLICATION_ENV:?APPLICATION_ENV is required}",
        "CONFIG_ENDPOINT=xstockstrat-config:50060",
        "IDENTITY_ENDPOINT=xstockstrat-identity:50058",
        "INDICATORS_ENDPOINT=xstockstrat-indicators:50054",
        "INGEST_ENDPOINT=xstockstrat-ingest:50055",
        "JWT_SECRET=${JWT_SECRET:?JWT_SECRET is required}",
        "MARKETDATA_ENDPOINT=xstockstrat-marketdata:50053",
        "MCP_HTTP_PORT=9000",
        "MCP_TRANSPORT=http",
        "MTLS_CA_CERT=${MTLS_CA_CERT:?MTLS_CA_CERT is required}",
        "MTLS_CERT=${AGENT_MTLS_CERT:?AGENT_MTLS_CERT is required}",
        "MTLS_KEY=${AGENT_MTLS_KEY:?AGENT_MTLS_KEY is required}",
        "NOTIFY_ENDPOINT=xstockstrat-notify:50059",
        "OTEL_ENABLED=false",
        "PORTFOLIO_ENDPOINT=xstockstrat-portfolio:50052",
        "SERVICE_NAME=agent",
        "TRADING_ENDPOINT=xstockstrat-trading:50051",
        "TRADING_MODE=${TRADING_MODE:?TRADING_MODE is required}",
        "UI_BASE_URL=${APP_URL}",
        "WAIT_FOR=xstockstrat-config:50060 xstockstrat-identity:50058",
        "SMOKE_ENDPOINT=xstockstrat-smoke:9110"
      ],
      "healthcheck": {
        "interval": "5s",
        "retries": 6,
        "start_period": "120s",
        "test": [
          "CMD",
          "bash",
          "-c",
          "echo \u003e /dev/tcp/127.0.0.1/9000"
        ],
        "timeout": "5s"
      },
      "image": "${IMAGE_AGENT:?IMAGE_AGENT is required}",
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9000",
          "target": 9000
        }
      ],
      "restart": "unless-stopped"
    },
    "xstockstrat-analysis": {
      "depends_on": {
        "xstockstrat-ingest": {
          "condition": "service_healthy",
          "required": true
        },
        "xstockstrat-trading": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "APPLICATION_ENV": "${APPLICATION_ENV:?APPLICATION_ENV is required}",
        "CONFIG_ENDPOINT": "xstockstrat-config:50060",
        "DATABASE_URL": "postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:6432/${DB_NAME}?sslmode=require",
        "DB_PGBOUNCER": "true",
        "GRPC_PORT": "50056",
        "INDICATORS_ENDPOINT": "xstockstrat-indicators:50054",
        "INGEST_ENDPOINT": "xstockstrat-ingest:50055",
        "LEDGER_ENDPOINT": "xstockstrat-ledger:50057",
        "MARKETDATA_ENDPOINT": "xstockstrat-marketdata:50053",
        "MTLS_CA_CERT": "${MTLS_CA_CERT:?MTLS_CA_CERT is required}",
        "MTLS_CERT": "${ANALYSIS_MTLS_CERT:?ANALYSIS_MTLS_CERT is required}",
        "MTLS_KEY": "${ANALYSIS_MTLS_KEY:?ANALYSIS_MTLS_KEY is required}",
        "NOTIFY_ENDPOINT": "xstockstrat-notify:50059",
        "OTEL_ENABLED": "false",
        "PORTFOLIO_ENDPOINT": "xstockstrat-portfolio:50052",
        "SERVICE_NAME": "analysis",
        "TRADING_ENDPOINT": "xstockstrat-trading:50051",
        "TRADING_MODE": "${TRADING_MODE:?TRADING_MODE is required}",
        "WAIT_FOR": "xstockstrat-config:50060 xstockstrat-ledger:50057 xstockstrat-indicators:50054 xstockstrat-trading:50051"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 6,
        "start_period": "120s",
        "test": [
          "CMD",
          "bash",
          "-c",
          "echo \u003e /dev/tcp/127.0.0.1/50056"
        ],
        "timeout": "5s"
      },
      "image": "${IMAGE_ANALYSIS:?IMAGE_ANALYSIS is required}",
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "xstockstrat-config": {
      "depends_on": {
        "db-migrator": {
          "condition": "service_completed_successfully",
